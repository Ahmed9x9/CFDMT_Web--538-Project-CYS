# Local development example. Docker Compose already sets its own container values.
CFDMT_DB_HOST=127.0.0.1
CFDMT_DB_NAME=cfdmt_web
CFDMT_DB_USER=root
CFDMT_DB_PASS=
CFDMT_ENGINE_URL=http://127.0.0.1:8000
CFDMT_TOOL_ROOT=.\cfdmt_tool
CFDMT_PYTHON=
CFDMT_DOWNLOAD_SECRET=replace-with-a-long-random-download-secret
CFDMT_ENGINE_SECRET=replace-with-a-long-random-engine-secret
